-- Detectar calabazas
local function esCalabaza(obj)
	local nombre = string.lower(obj.Name)
	return string.find(nombre, "pumpkin")
		or string.find(nombre, "calabaza")
end

local datosCalabazas = {}

local function obtenerParte(obj)
	if obj:IsA("BasePart") then
		return obj
	end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function ocultarCalabaza(obj)
	if not esCalabaza(obj) then return end

	local parte = obtenerParte(obj)
	if not parte then return end

	if not datosCalabazas[obj] then
		datosCalabazas[obj] = {
			CFrame = parte.CFrame,
			Size = parte.Size
		}
	end

	parte.Size = datosCalabazas[obj].Size * 0.1
	parte.CFrame = datosCalabazas[obj].CFrame
		+ Vector3.new(0, -500, 0)
end

local function mostrarCalabaza(obj)
	if not esCalabaza(obj) then return end

	local parte = obtenerParte(obj)
	local datos = datosCalabazas[obj]

	if not parte or not datos then return end

	parte.CFrame = datos.CFrame
	parte.Size = datos.Size
end

local function actualizarCalabazas()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if esCalabaza(obj) then
			if activo then
				ocultarCalabaza(obj)
			else
				mostrarCalabaza(obj)
			end
		end
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if activo and esCalabaza(obj) then
		task.wait()
		ocultarCalabaza(obj)
	end
end)

-- Botón Auto Farm
boton.Activated:Connect(function()
	activo = not activo
	boton.Text = activo and "AUTO FARM: ON" or "AUTO FARM: OFF"
	actualizarCalabazas()
end)

-- Movimiento de ventana: PC y celular
local arrastrando = false
local posicionInicial
local entradaInicial
local toqueActivo

titulo.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		arrastrando = true
		toqueActivo = input
		entradaInicial = input.Position
		posicionInicial = ventana.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not arrastrando then return end

	if input == toqueActivo
		or input.UserInputType == Enum.UserInputType.MouseMovement then

		local delta = input.Position - entradaInicial

		ventana.Position = UDim2.new(
			posicionInicial.X.Scale,
			posicionInicial.X.Offset + delta.X,
			posicionInicial.Y.Scale,
			posicionInicial.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == toqueActivo
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		arrastrando = false
		toqueActivo = nil
	end
end)

-- Evento periódico
